meta {
  name: project_empty_name_lookup
  type: http
  seq: 47
}

get {
  url: {{baseURL}}/api/v0/projects/{{projectB}}/tags?name=missing
  body: none
  auth: none
}

tests {
  test("project_empty_name_lookup: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.4");
  });
  test("project_empty_name_lookup: response", function () {
    const body = res.getBody();
    expect(body.tags).to.deep.equal([]);
  });
}
