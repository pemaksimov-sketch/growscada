meta {
  name: update_widget
  type: http
  seq: 19
}

put {
  url: {{baseURL}}/api/v0/scenes/{{sceneID}}/widgets/{{widgetID}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "CI moved widget",
    "position": {
      "x": 40,
      "y": 50,
      "z": 0
    },
    "size": {
      "width": 120,
      "height": 60
    },
    "origin": {
      "x": 0.5,
      "y": 0.5
    },
    "rotation": {
      "degrees": 0
    },
    "type_id": "{{typeID}}",
    "labels": [],
    "port_bindings": [
      {
        "port_name": "n",
        "tag_id": "{{tagID}}"
      }
    ],
    "scene_version": {{sceneVersion}}
  }
}

tests {
  test("update_widget: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("update_widget: response", function () {
    const body = res.getBody();

    expect(body.scene_version).to.equal(3); bru.setVar("sceneVersion", body.scene_version);
  });
}
