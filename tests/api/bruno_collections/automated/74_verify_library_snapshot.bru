meta {
  name: verify_library_snapshot
  type: http
  seq: 79
}

get {
  url: {{baseURL}}/api/v0/libraries/{{testLibraryID}}/releases
  body: none
  auth: none
}

tests {
  test("verify_library_snapshot: includes the saved type", function () {
    expect(res.getStatus()).to.equal(200);
    const release = res.getBody().releases[0];
    expect(release.number).to.equal(1);
    expect(release.content.widget_types[0].id).to.equal(bru.getVar("libraryWidgetTypeID"));
  });
}
