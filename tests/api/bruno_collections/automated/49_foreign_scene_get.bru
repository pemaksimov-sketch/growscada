meta {
  name: foreign_scene_get
  type: http
  seq: 49
}

get {
  url: {{baseURL}}/api/v0/projects/{{projectB}}/scenes/{{projectSceneA}}
  body: none
  auth: none
}

tests {
  test("foreign_scene_get: status and schema header", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.3");
  });
  test("foreign_scene_get: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(404); expect(body.title).to.be.a("string").and.not.empty;
  });
}
