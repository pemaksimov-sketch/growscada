tests {
  test("create_project_a: status and schema header", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.4");
  });
  test("create_project_a: response", function () {
    const body = res.getBody();
    expect(body.version).to.equal(1); bru.setVar("projectA",body.id);
  });
