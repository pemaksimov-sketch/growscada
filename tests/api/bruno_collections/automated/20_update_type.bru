meta {
  name: update_type
  type: http
  seq: 20
}

put {
  url: {{baseURL}}/api/v0/widget-types/{{typeID}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "CI updated type",
    "html_template": "<div id=\"counter\"></div>",
    "script": "function render(inputs) { document.querySelector('#counter').textContent = inputs.n.raw; }",
    "script_language": "javascript",
    "default_width": 120,
    "default_height": 60,
    "input_ports": [
      {
        "name": "n",
        "description": "Counter",
        "type_hint": "integer"
      }
    ],
    "version": 1
  }
}

tests {
  test("update_type: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("update_type: response", function () {
    const body = res.getBody();

    expect(body.version).to.equal(2);
  });
}
