meta {
  name: get_project_widget_origin
  type: http
  seq: 55
}

get {
  url: {{baseURL}}/api/v0/projects/{{projectB}}/scenes/{{projectSceneB}}/widgets/{{projectWidgetB}}
  body: none
  auth: none
}

tests {
  test("get_project_widget_origin: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.4");
  });
  test("get_project_widget_origin: entity origin", function () {
    expect(res.getBody().entity_origin).to.equal("Project");
  });
}
