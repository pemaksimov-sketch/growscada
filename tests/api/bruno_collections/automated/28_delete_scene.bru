meta {
  name: delete_scene
  type: http
  seq: 30
}

delete {
  url: {{baseURL}}/api/v0/scenes/{{sceneID}}
  body: none
  auth: none
}

tests {
  test("delete_scene: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
}
