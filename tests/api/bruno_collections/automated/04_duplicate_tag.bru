meta {
  name: duplicate_tag
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/api/v0/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "ci.counter",
    "type": "integer",
    "value": "0",
    "quality": "good"
  }
}

tests {
  test("duplicate_tag: status and schema header", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("duplicate_tag: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(409); expect(body.title).to.be.a("string").and.not.empty; expect(body.detail).to.be.a("string");

  });
}
