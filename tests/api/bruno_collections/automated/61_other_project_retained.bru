meta {
  name: other_project_retained
  type: http
  seq: 61
}

get {
  url: {{baseURL}}/api/v0/projects/{{projectB}}/tags
  body: none
  auth: none
}

tests {
  test("other_project_retained: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.3");
  });
  test("other_project_retained: response", function () {
    const body = res.getBody();
    expect(body.tags).to.have.length(1); expect(body.tags[0].id).to.equal(bru.getVar("projectTagB"));
  });
}
