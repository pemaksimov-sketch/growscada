meta {
  name: foreign_tag_delete
  type: http
  seq: 45
}

delete {
  url: {{baseURL}}/api/v0/projects/{{projectB}}/tags/{{projectTagA}}
  body: none
  auth: none
}

tests {
  test("foreign_tag_delete: status and schema header", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.3");
  });
  test("foreign_tag_delete: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(404); expect(body.title).to.be.a("string").and.not.empty;
  });
}
