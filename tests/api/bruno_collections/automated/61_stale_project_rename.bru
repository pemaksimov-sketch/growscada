meta {
  name: stale_project_rename
  type: http
  seq: 67
}

put {
  url: {{baseURL}}/api/v0/projects/{{projectA}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "stale",
    "version": 1
  }
}

tests {
  test("stale_project_rename: status and schema header", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.5");
  });
  test("stale_project_rename: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(409); expect(body.title).to.be.a("string").and.not.empty;
  });
}
