meta {
  name: stale_widget
  type: http
  seq: 18
}

put {
  url: {{baseURL}}/api/v0/scenes/{{sceneID}}/widgets/{{widgetID}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "CI moved widget",
    "position": {
      "x": 40,
      "y": 50,
      "z": 0
    },
    "size": {
      "width": 120,
      "height": 60
    },
    "origin": {
      "x": 0.5,
      "y": 0.5
    },
    "rotation": {
      "degrees": 0
    },
    "type_id": "{{typeID}}",
    "labels": [],
    "port_bindings": [
      {
        "port_name": "n",
        "tag_id": "{{tagID}}"
      }
    ],
    "scene_version": 1
  }
}

tests {
  test("stale_widget: status and schema header", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("stale_widget: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(409); expect(body.title).to.be.a("string").and.not.empty; expect(body.detail).to.be.a("string");

  });
}
