meta {
  name: get_widget
  type: http
  seq: 16
}

get {
  url: {{baseURL}}/api/v0/scenes/{{sceneID}}/widgets/{{widgetID}}
  body: none
  auth: none
}

tests {
  test("get_widget: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("get_widget: response", function () {
    const body = res.getBody();

    expect(body.scene_id).to.equal(bru.getVar("sceneID")); expect(body.port_bindings[0].tag_id).to.equal(bru.getVar("tagID")); expect(body.entity_origin).to.equal("Project");
  });
}
