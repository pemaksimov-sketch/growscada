meta {
  name: stale_tag
  type: http
  seq: 7
}

patch {
  url: {{baseURL}}/api/v0/tags/{{tagID}}/value
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "value": "2",
    "quality": "good",
    "version": 1
  }
}

tests {
  test("stale_tag: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("stale_tag: response", function () {
    const body = res.getBody();
    expect(body.version).to.equal(1); expect(body.sequence).to.equal(3);

  });
}
