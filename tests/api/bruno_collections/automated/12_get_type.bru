meta {
  name: get_type
  type: http
  seq: 12
}

get {
  url: {{baseURL}}/api/v0/libraries/00000000-0000-4000-8000-000000000003/widget-types/{{typeID}}
  body: none
  auth: none
}

tests {
  test("get_type: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("get_type: response", function () {
    const body = res.getBody();

    expect(body.input_ports[0].type_hint).to.equal("integer"); expect(body.version).to.equal(1);
  });
}
