meta {
  name: verify_project_library_pin
  type: http
  seq: 76
}

get {
  url: {{baseURL}}/api/v0/projects/{{mainProject}}/libraries
  body: none
  auth: none
}

tests {
  test("verify_project_library_pin: project shows the selected release", function () {
    expect(res.getStatus()).to.equal(200);
    const pin = res.getBody().pins.find(item => item.library_id === bru.getVar("testLibraryID"));
    expect(pin).to.exist;
    expect(pin.release.id).to.equal(bru.getVar("testLibraryReleaseID"));
  });
}
