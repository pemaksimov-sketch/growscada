meta {
  name: delete_used_type
  type: http
  seq: 21
}

delete {
  url: {{baseURL}}/api/v0/widget-types/{{typeID}}
  body: none
  auth: none
}

tests {
  test("delete_used_type: status and schema header", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("delete_used_type: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(409); expect(body.title).to.be.a("string").and.not.empty; expect(body.detail).to.be.a("string");

  });
}
