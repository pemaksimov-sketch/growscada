meta {
  name: final_projects
  type: http
  seq: 64
}

get {
  url: {{baseURL}}/api/v0/projects
  body: none
  auth: none
}

tests {
  test("final_projects: status and schema header", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.equal("0.3");
  });
  test("final_projects: response", function () {
    const body = res.getBody();
    expect(body.projects).to.have.length(1); expect(body.projects[0].id).to.equal(bru.getVar("mainProject"));
  });
}
