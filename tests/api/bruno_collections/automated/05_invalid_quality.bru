meta {
  name: invalid_quality
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/api/v0/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "ci.invalid",
    "type": "integer",
    "value": "0",
    "quality": "invalid"
  }
}

tests {
  test("invalid_quality: status and schema header", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("GrowSCADA-Schema-Version")).to.match(/^\d+\.\d+$/);
  });
  test("invalid_quality: response", function () {
    const body = res.getBody();
    expect(body.status).to.equal(400); expect(body.title).to.be.a("string").and.not.empty; expect(body.detail).to.be.a("string");

  });
}
